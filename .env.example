# Public env vars (Vite exposes only keys prefixed with VITE_)

# Backend API base URL (no trailing slash).
# Example: direct to Nest during local dev
VITE_API_URL=http://localhost:3000

# Apex domain for tenant subdomain parsing (no scheme).
# Used by extractTenantSlug() to read the label before this domain:
#   acfc.sportbooker.com → acfc
#   platform.sportbooker.com → platform
#   sportbooker.com / www.sportbooker.com → no tenant (null)
VITE_APP_DOMAIN=sportbooker.com

# When the hostname is localhost or 127.0.0.1 there is no subdomain in the URL.
# Set a default slug for dev, or omit for null (see src/lib/tenant.ts).
VITE_DEV_TENANT_SLUG=acfc

# Legacy alias (lib/api-url.ts falls back if VITE_API_URL is unset)
# VITE_API_BASE_URL=http://localhost:3000

# --- Optional: Vite proxy (tenant Host injection for Nest) ---
# If your backend requires Host like acfc.localhost:3000, use VITE_API_URL=/api and
# configure vite.config.ts — see docs/local-development.md
