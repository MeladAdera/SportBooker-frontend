# Public env vars (Vite exposes only keys prefixed with VITE_)

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:3000

# Apex domain for tenant subdomain parsing (no scheme), e.g. acfc.sportbooker.com → acfc
VITE_APP_DOMAIN=sportbooker.com

# When using plain localhost (no *.localhost), optional default tenant slug for API/tenant context
# VITE_DEV_TENANT_SLUG=acfc

# Legacy alias (apiFetch falls back if VITE_API_URL is unset)
# VITE_API_BASE_URL=http://localhost:3000
