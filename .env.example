# Public env vars (Vite exposes only keys prefixed with VITE_)

# Backend API base URL (no trailing slash).
# Production: https://api.sportbooker.net
# Local dev:  http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# Alias (api-url.ts checks VITE_API_URL first, then VITE_API_BASE_URL)
# VITE_API_URL=http://localhost:3000

# Apex domain for tenant subdomain parsing (no scheme).
# Used by extractTenantSlug() to read the label before this domain:
#   acfc.sportbooker.net  → acfc   (tenant context)
#   app.sportbooker.net   → null   (login/register/picker)
#   platform.sportbooker.net → null (platform admin)
VITE_APP_DOMAIN=sportbooker.net

# When the hostname is localhost or 127.0.0.1 there is no subdomain in the URL.
# Set a default slug for dev, or omit for null (see src/lib/tenant.ts).
VITE_DEV_TENANT_SLUG=acfc

# Tenant used when the hostname is NOT under VITE_APP_DOMAIN (e.g. a *.vercel.app demo).
# VITE_DEFAULT_TENANT_SLUG=acfc

# --- Optional: Vite proxy (X-Tenant-Slug injection for backend) ---
# If you want same-origin dev requests, set VITE_API_URL=/api and
# the Vite proxy in vite.config.ts will forward to localhost:3000
# with the X-Tenant-Slug header injected automatically.
